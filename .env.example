# AutoPatch Environment Configuration

# Application
APP_NAME=AutoPatch
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./autopatch.db

# Scanning Configuration
SCAN_TIMEOUT=120
TEST_TIMEOUT=60
MAX_PATCH_RETRIES=3
DOCKER_ENABLED=false

# LLM Configuration (Phase 5+)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
# OPENAI_API_KEY=your-api-key-here
# ANTHROPIC_API_KEY=your-api-key-here
