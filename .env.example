# AutoPatch Environment Configuration

# Application
APP_NAME=AutoPatch
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Defaults to the API working directory. Set an absolute root to allow other repositories.
# ALLOWED_REPOSITORY_ROOT=D:/projects
WORKFLOW_WORKERS=2
WORKFLOW_QUEUE_LIMIT=8

# Database
DATABASE_URL=sqlite:///./autopatch.db

# Scanning Configuration
SCAN_TIMEOUT=120
TEST_TIMEOUT=60
MAX_PATCH_RETRIES=3
DOCKER_ENABLED=false
ALLOW_LOCAL_FALLBACK=true
DOCKER_IMAGE=autopatch-validator:latest

# LLM Configuration
LLM_TIMEOUT=120
LLM_MAX_OUTPUT_TOKENS=4096
# For OpenAI Cloud:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# OPENAI_API_KEY=your-api-key-here

# For Local Ollama:
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:7b
LLM_BASE_URL=http://localhost:11434/v1
